# Generated song index and decoded audio
cache/

# The song libraries: Rocksmith song sets and downloaded custom songs (not shared)
bundles/
cdlc/

# Your own recordings (not shared)
music/*
!music/.gitkeep

# Third-party decoder binaries (download from https://github.com/vgmstream/vgmstream/releases)
tools/vgmstream/

# Local settings
config.json

node_modules/

# Takes saved for tuning the scoring (your playing)
takes/

# The web demo, built by tools/build-web.sh
public/
.web-preview/
# .claude/ is local, except the skills a cloud session needs (games-meta STANDARD.md §12).
# Last in the file so no rule above can hide part of a skill.
!.claude/
.claude/*
!.claude/skills/
!.claude/skills/**
.claude/skills/**/.DS_Store
